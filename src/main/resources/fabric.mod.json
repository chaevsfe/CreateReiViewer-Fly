{
  "schemaVersion": 1,
  "id": "createreiviewer",
  "version": "${version}",
  "name": "Create Fly: Recipe Viewer",
  "icon": "assets/createreiviewer/icon.png",
  "description": "Shows Create Fly's machine recipes in Roughly Enough Items on Fabric.",
  "authors": [
    "chaevsfe"
  ],
  "contact": {
    "homepage": "https://github.com/chaevsfe/CreateReiViewer-Fly",
    "sources": "https://github.com/chaevsfe/CreateReiViewer-Fly",
    "issues": "https://github.com/chaevsfe/CreateReiViewer-Fly/issues",
    "upstream": "https://modrinth.com/mod/create-fly"
  },
  "license": [
    "MIT"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.chaevsfe.createreiviewer.CreateReiViewer"
    ],
    "client": [
      "dev.chaevsfe.createreiviewer.client.ViewerClient"
    ],
    "rei_common": [
      "dev.chaevsfe.createreiviewer.plugin.CreateReiCommonPlugin"
    ],
    "rei_client": [
      "dev.chaevsfe.createreiviewer.client.CreateReiClientPlugin"
    ]
  },
  "mixins": [
    "createreiviewer.mixins.json",
    "createreiviewer.architectury.mixins.json",
    {
      "config": "createreiviewer.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "createreiviewer.accesswidener",
  "depends": {
    "minecraft": "${minecraft_dependency_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "${fabric_api_version_range}",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  },
  "suggests": {
    "roughlyenoughitems": "*"
  },
  "breaks": {
    "roughlyenoughitems": "${rei_version_breaks}"
  }
}
